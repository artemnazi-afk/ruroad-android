<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RuRoad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <!-- Плавающее окно поиска из виджета: floating-dialog, фон прозрачный, размер задаётся в коде под контент -->
    <!-- Плавающее окно из виджета: живёт в отдельной задаче, поэтому вместо translucency
         просим систему рисовать обои за окном (windowShowWallpaper). Размер в коде под контент. -->
    <style name="Theme.RuRoad.SearchDialog" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
