<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <!-- строка навигации: назад / заголовок / сброс -->
    <LinearLayout
        android:id="@+id/widget_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/widget_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/field_bg"
            android:src="@drawable/ic_back"
            android:tint="@color/text_dim"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="@string/desc_back" />

        <TextView
            android:id="@+id/widget_chrome_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- строка поиска: поле + лупа -->
    <LinearLayout
        android:id="@+id/widget_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_field"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:background="@drawable/field_bg"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_hint"
            android:textColor="@color/text_dim"
            android:textSize="22sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/widget_find"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary"
            android:src="@drawable/ic_search"
            android:tint="#14181F"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="@string/search_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/search_empty"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- результаты поиска -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@color/stroke"
        android:dividerHeight="1dp"
        android:visibility="gone" />

    <!-- карточка объекта (как на карте). ScrollView нельзя — не входит в whitelist RemoteViews -->
    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wc_cad"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="#7FD3FF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageButton
                    android:id="@+id/wc_route_head"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@null"
                    android:src="@drawable/ic_nav"
                    android:tint="@color/primary"
                    android:scaleType="centerInside"
                    android:padding="4dp"
                    android:contentDescription="@string/route_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/wc_quarter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/wc_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#7FD3FF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/wc_row_addr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/f_address" android:textColor="@color/text_dim" android:textSize="10.5sp" />
                <TextView android:id="@+id/wc_addr" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_main" android:textSize="12sp"
                    android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wc_row_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/f_area" android:textColor="@color/text_dim" android:textSize="10.5sp" />
                <TextView android:id="@+id/wc_area" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_main" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wc_row_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/f_status" android:textColor="@color/text_dim" android:textSize="10.5sp" />
                <TextView android:id="@+id/wc_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_main" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wc_row_landcat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/f_landcat" android:textColor="@color/text_dim" android:textSize="10.5sp" />
                <TextView android:id="@+id/wc_landcat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_main" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wc_row_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="3dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/f_perm" android:textColor="@color/text_dim" android:textSize="10.5sp" />
                <TextView android:id="@+id/wc_perm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_main" android:textSize="12sp"
                    android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>

            <!-- спейсер: кнопки прижимаются к низу шторки на любой высоте (TextView — разрешён в RemoteViews) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/wc_map"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_secondary"
                    android:text="@string/map_button"
                    android:textColor="@color/text_main"
                    android:textSize="12.5sp" />

                <ImageButton
                    android:id="@+id/wc_route"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_primary"
                    android:src="@drawable/ic_nav"
                    android:tint="#14181F"
                    android:scaleType="centerInside"
                    android:padding="9dp"
                    android:contentDescription="@string/route_button" />
            </LinearLayout>
    </LinearLayout>

</LinearLayout>
